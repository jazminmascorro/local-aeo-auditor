# Session signing (required in production)
SESSION_SECRET=change-me-to-a-long-random-string
# SESSION_HTTPS_ONLY=true

# Public base URL used for Google OAuth callback
APP_BASE_URL=http://127.0.0.1:8000

# Google OAuth (Google Cloud Console → OAuth client)
# Authorized redirect URI: {APP_BASE_URL}/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# When Google is unset, dev login is auto-enabled. Force with:
# AUTH_DEV_MODE=true

# Auto-join this workspace on first login if the user has no memberships
AUTH_AUTO_JOIN_WORKSPACE=dutch-bros

# RQ / Redis
REDIS_URL=redis://127.0.0.1:6379/0

# Optional crawl overrides
# AEO_CRAWL_DELAY=1.0
# AEO_CONCURRENCY=2
# AEO_USER_AGENT=LocationAnswerabilityAuditor/0.1 (+https://github.com/jazminmascorro/local-aeo-auditor)

# Optional LLM
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
